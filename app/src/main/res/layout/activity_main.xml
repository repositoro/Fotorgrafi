<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Bar iOS: Tone Profile & Toggle Manual Pro -->
    <LinearLayout
        android:id="@+id/iosTopBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnColorTone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ios_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="TONE: VIVID WARM"
            android:textColor="#FFD60A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnTogglePro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ios_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="PRO ▲"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Viewfinder Utama + Grid 3x3 iOS -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glViewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintTop_toBottomOf="@id/iosTopBar"
        app:layout_constraintBottom_toTopOf="@id/iosBottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.repositoro.fotorgrafi.ui.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/glViewFinder"
        app:layout_constraintBottom_toBottomOf="@id/glViewFinder"
        app:layout_constraintStart_toStartOf="@id/glViewFinder"
        app:layout_constraintEnd_toEndOf="@id/glViewFinder" />

    <!-- Panel Kontrol Manual Pro (Floating iOS Drawer di bagian bawah viewfinder) -->
    <LinearLayout
        android:id="@+id/proControlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ios_pill"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/glViewFinder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="EV: 0.0  |  ISO: AUTO  |  SS: AUTO"
                android:textColor="#FFD60A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnResetAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFD60A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="AUTO"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="EV"
                android:textColor="#EBEBF5"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekEv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressBackgroundTint="#48484A"
                android:progressTint="#FFD60A"
                android:thumbTint="#FFD60A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ISO"
                android:textColor="#EBEBF5"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#48484A"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SS"
                android:textColor="#EBEBF5"
                android:textSize="10sp" />

            <SeekBar
                android:id="@+id/seekShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressBackgroundTint="#48484A"
                android:progressTint="#FFFFFF"
                android:thumbTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Dock iOS: Mode Dial & Double-Ring Shutter -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/iosBottomDock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pemilih Mode Horizontal bergaya iOS -->
        <LinearLayout
            android:id="@+id/iosModeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/shutterContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tabVideoMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="VIDEO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPhotoMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="FOTO"
                android:textColor="#FFD60A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Shutter Double-Ring iPhone -->
        <!-- Tombol Shutter Double-Ring iPhone -->
        <!-- Tombol Shutter Double-Ring iPhone Presisi -->
        <FrameLayout
            android:id="@+id/shutterContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_ios_shutter_ring"
            app:layout_constraintTop_toBottomOf="@id/iosModeRow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/btnCapture"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ios_shutter_inner"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Shutter" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>